# Flask Configuration
FLASK_APP=model/app.py
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5001

# Application Settings
APP_NAME=PacketVision
APP_VERSION=1.0.0
SECRET_KEY=your-secure-secret-key-change-in-production

# Model Configuration
MODEL_PATH=A:/kle tech/SDP/packet-vision/model/models/traffic_model.h5
SCALER_PATH=A:/kle tech/SDP/packet-vision/model/models/scaler.pkl
LABEL_ENCODER_PATH=A:/kle tech/SDP/packet-vision/model/models/label_encoder.pkl

# API Configuration
API_BASE_URL=http://127.0.0.1:5001
CORS_ORIGINS=*
MAX_CONTENT_LENGTH=16777216

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_ENABLED=True
SESSION_TIMEOUT=3600

# Model Performance Settings
PREDICTION_THRESHOLD=0.5
BATCH_SIZE=32
MAX_PREDICTIONS_PER_MINUTE=100

# Feature Settings
FEATURE_NAMES=flowDuration,totalFwdPackets,totalBackwardPackets,fwdPacketLengthMax,bwdPacketLengthMax
FEATURE_COUNT=5

# Cache Settings
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
